# Synthetic local-only configuration. Explicitly source this in each terminal.
APP_ENV=local-emulator
AUTH_PROVIDER=firebase
MODEL_PROVIDER=fake
GCP_PROJECT_ID=demo-brainoid
GCP_REGION=asia-northeast1
FIRESTORE_DATABASE_ID='(default)'
MODEL_ID=fake-model
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
LOG_LEVEL=INFO
READINESS_TIMEOUT_SECONDS=2
# Synthetic emulator-only key. Never use in staging/production.
CURSOR_SIGNING_KEY=synthetic-cursor-signing-key-for-tests-only
# Independent local ledger persists across emulator DB resets/restarts.
AUTHZ_LEDGER_DIRECTORY=/tmp/brainoid-demo-authz-ledger

# Explicit synthetic device signing/encryption keys. Never use outside local-emulator.
DEVICE_TOKEN_PROVIDER=local-test
DEVICE_TOKEN_KEYRING_FILE="$PWD/tests/fixtures/device_tokens/local-keyring.json"
DEVICE_CREDENTIAL_EPOCH=00000000-0000-0000-0000-000000000001

# Real STT is forbidden locally; tests inject a fake recognizer explicitly.
STT_PROVIDER=disabled

# TTS stays disabled until explicit OPEN-005 voice/location acceptance.
TTS_PROVIDER=disabled
# Cloud only: TTS_PROVIDER=google-v1, TTS_LOCATION, TTS_VOICE (ja-JP name).
