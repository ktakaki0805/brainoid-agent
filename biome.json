{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "files": {
    "includes": [
      "apps/**",
      "packages/ui/**",
      "packages/api-client/**",
      "packages/openapi-generator/**",
      "!packages/api-client/src/generated",
      "scripts/*.mjs",
      "tests/*.mjs",
      "tests/fixtures/tenants/*.json",
      "firebase.json",
      "openapi-ts.config.mjs",
      "package.json",
      "tsconfig.base.json",
      "biome.json"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": { "rules": { "preset": "recommended" } },
  "javascript": { "formatter": { "quoteStyle": "double" } }
}
