# Safe, explicitly selected local configuration. No secrets or real cloud resources.
# Export these variables before starting the API; it does not automatically read .env.
APP_ENV=local-fake
AUTH_PROVIDER=fake
MODEL_PROVIDER=fake
GCP_PROJECT_ID=demo-brainoid
GCP_REGION=asia-northeast1
FIRESTORE_DATABASE_ID='(default)'
MODEL_ID=fake-model
LOG_LEVEL=INFO
READINESS_TIMEOUT_SECONDS=2

# local-emulator additionally requires AUTH_PROVIDER=firebase and both hosts:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
