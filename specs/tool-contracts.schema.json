{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brainoid Agent model tool-call input contract",
  "description": "LLMはnameとargumentsのみ提案する。TenantContext/ActorContext/承認・scopeを引数から信用しない。Calendar confirmはモデルtoolとして公開しない。削除・共有・外部副作用は明示ユーザー意図を別途検査。",
  "oneOf": [
    {
      "$ref": "#/$defs/memory_search"
    },
    {
      "$ref": "#/$defs/memory_remember"
    },
    {
      "$ref": "#/$defs/memory_revise"
    },
    {
      "$ref": "#/$defs/memory_forget"
    },
    {
      "$ref": "#/$defs/note_create"
    },
    {
      "$ref": "#/$defs/note_list"
    },
    {
      "$ref": "#/$defs/note_update"
    },
    {
      "$ref": "#/$defs/note_delete"
    },
    {
      "$ref": "#/$defs/task_create"
    },
    {
      "$ref": "#/$defs/task_list"
    },
    {
      "$ref": "#/$defs/task_update"
    },
    {
      "$ref": "#/$defs/task_delete"
    },
    {
      "$ref": "#/$defs/reminder_create"
    },
    {
      "$ref": "#/$defs/reminder_list"
    },
    {
      "$ref": "#/$defs/reminder_update"
    },
    {
      "$ref": "#/$defs/reminder_snooze"
    },
    {
      "$ref": "#/$defs/calendar_list"
    },
    {
      "$ref": "#/$defs/calendar_propose"
    },
    {
      "$ref": "#/$defs/home_set_state"
    }
  ],
  "$defs": {
    "memory_search": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "const": "memory.search"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 40,
              "default": 10
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    "memory_remember": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "const": "memory.remember"
        },
        "arguments": {
          "$ref": "#/$defs/MemoryCreate"
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    "memory_revise": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "const": "memory.revise"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "memory_id": {
              "type": "string",
              "format": "uuid"
            },
            "expected_version": {
              "type": "integer",
              "minimum": 1
            },
            "replacement": {
              "$ref": "#/$defs/MemoryCreate"
            }
          },
          "required": [
            "memory_id",
            "expected_version",
            "replacement"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    "memory_forget": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "const": "memory.forget"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "memory_id": {
              "type": "string",
              "format": "uuid"
            },
            "expected_version": {
              "type": "integer",
              "minimum": 1
            },
            "source_policy": {
              "type": "string",
              "enum": [
                "suppress_reuse",
                "delete_source"
              ]
            }
          },
          "required": [
            "memory_id",
            "expected_version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    "note_create": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "const": "notes.create"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "body": {
              "type": "string",
              "maxLength": 8000
            },
            "visibility": {
              "type": "string",
              "enum": [
                "private",
                "shared"
              ]
            },
            "display_policy": {
              "type": "string",
              "enum": [
                "never",
                "authenticated_session",
                "shared_display"
              ]
            }
          },
          "required": [
            "title",
            "body",
            "visibility",
            "display_policy"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "visibility": {
                    "const": "private"
                  }
                },
                "required": [
                  "visibility"
                ]
              },
              "then": {
                "properties": {
                  "display_policy": {
                    "type": "string",
                    "enum": [
                      "never",
                      "authenticated_session"
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    "note_list": {
