    "home_set_state": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "const": "home.set_state"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "device_id": {
              "type": "string",
              "format": "uuid"
            },
            "target_entity_id": {
              "type": "string",
              "format": "uuid"
            },
            "operation": {
              "$ref": "#/$defs/HomeAction"
            }
          },
          "required": [
            "device_id",
            "target_entity_id",
            "operation"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    "MemoryCreate": {
      "type": "object",
      "properties": {
        "subject_entity_id": {
          "type": "string",
          "format": "uuid"
        },
        "predicate": {
          "type": "string",
          "enum": [
            "located_in",
            "prefers_setting",
            "prefers",
            "related_to",
            "has_attribute"
          ]
        },
        "object_entity_id": {
          "type": "string",
          "format": "uuid"
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean"
          ],
          "maxLength": 4000
        },
        "qualifiers": {
          "type": "object",
          "properties": {
            "context": {
              "type": "string",
              "maxLength": 200
            },
            "brightness_pct": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "temperature_c": {
              "type": "number",
              "minimum": 16,
              "maximum": 30
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "visibility": {
          "type": "string",
          "enum": [
            "private",
            "shared"
          ]
        },
        "display_policy": {
          "type": "string",
          "enum": [
            "never",
            "authenticated_session",
            "shared_display"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "maxItems": 20
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "subject_entity_id",
        "predicate",
        "visibility",
        "display_policy"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "object_entity_id"
          ],
          "not": {
            "required": [
              "value"
            ]
          }
        },
        {
          "required": [
            "value"
          ],
          "not": {
            "required": [
              "object_entity_id"
            ]
          }
        }
      ],
      "description": "利用者の明示保存はuser_explicit/confirmedをサーバーが設定。private＋shared_displayを拒否。",
      "allOf": [
        {
          "if": {
            "properties": {
              "visibility": {
                "const": "private"
              }
            },
            "required": [
              "visibility"
            ]
          },
          "then": {
            "properties": {
              "display_policy": {
                "type": "string",
                "enum": [
                  "never",
                  "authenticated_session"
                ]
              }
            }
          }
        }
      ]
    },
    "SourceRef": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "message",
            "note",
            "import"
          ]
        },
        "resource_id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "kind",
        "resource_id",
        "version"
      ],
      "additionalProperties": false
    },
    "CalendarProposalCreate": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "const": "create"
            },
            "calendar_id": {
              "type": "string",
              "maxLength": 1024
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "start": {
              "$ref": "#/$defs/CalendarTime"
            },
            "end": {
              "$ref": "#/$defs/CalendarTime"
            },
            "description": {
              "type": "string",
              "maxLength": 4000
            }
          },
          "required": [
            "action",
            "calendar_id",
            "summary",
            "start",
            "end"
          ],
          "additionalProperties": false
