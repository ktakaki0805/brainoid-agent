            },
            "expected_version": {
              "type": "integer",
              "minimum": 1
            },
            "changes": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "open",
                    "done",
                    "cancelled"
                  ]
                },
                "due_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                }
              },
              "required": [],
              "additionalProperties": false,
              "minProperties": 1
            }
          },
          "required": [
            "task_id",
