              "type": "string",
              "format": "date-time"
            },
            "timezone": {
              "type": "string",
              "maxLength": 80
            },
            "expected_version": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "reminder_id",
            "due_at",
            "timezone",
            "expected_version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    "calendar_list": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "const": "calendar.list"
        },
        "arguments": {
          "type": "object",
          "properties": {
            "integration_id": {
              "type": "string",
              "format": "uuid"
            },
            "calendar_id": {
              "type": "string",
              "maxLength": 1024
            },
            "time_min": {
              "type": "string",
              "format": "date-time"
            },
            "time_max": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "integration_id",
            "calendar_id",
            "time_min",
            "time_max"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "additionalProperties": false
    },
    "calendar_propose": {
      "type": "object",
