        },
        "arguments": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "due_at": {
              "type": "string",
              "format": "date-time"
            },
            "timezone": {
              "type": "string",
              "maxLength": 80
            },
            "delivery_target": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "user",
                    "device"
                  ]
                },
                "id": {
                  "type": "string",
                  "maxLength": 128
                }
              },
              "required": [
                "kind",
                "id"
              ],
              "additionalProperties": false
            },
            "task_id": {
              "type": "string",
              "format": "uuid"
            },
            "visibility": {
              "type": "string",
              "enum": [
                "private",
                "shared"
              ]
            },
            "display_policy": {
              "type": "string",
              "enum": [
                "never",
                "authenticated_session",
                "shared_display"
              ]
            }
          },
          "required": [
            "title",
            "due_at",
            "timezone",
            "delivery_target",
            "visibility",
            "display_policy"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "visibility": {
                    "const": "private"
                  }
                },
                "required": [
                  "visibility"
                ]
              },
              "then": {
                "properties": {
                  "display_policy": {
                    "type": "string",
                    "enum": [
                      "never",
                      "authenticated_session"
