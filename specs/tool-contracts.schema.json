          "type": "object",
          "properties": {
            "integration_id": {
              "type": "string",
              "format": "uuid"
            },
            "change": {
              "$ref": "#/$defs/CalendarProposalCreate"
            }
          },
          "required": [
            "integration_id",
            "change"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "arguments"
      ],
