                "temperature_c": {
                  "type": "number"
                },
                "hvac_mode": {
                  "type": "string",
                  "enum": [
                    "off",
                    "heat",
                    "cool",
                    "auto"
                  ]
                }
              },
              "required": [],
              "additionalProperties": false,
              "minProperties": 1
            },
            "error_code": {
              "type": "string",
              "maxLength": 80
            }
          },
          "required": [
            "command_id",
            "execution_id",
            "status",
            "observed_at"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "succeeded"
                  }
                }
              },
              "then": {
                "required": [
                  "observed_state"
                ]
              }
            }
          ]
